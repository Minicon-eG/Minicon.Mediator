<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Minicon.Mediator</RootNamespace>
    <AssemblyName>Minicon.Mediator</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Package metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>Minicon.Mediator</PackageId>
    <Version>1.0.0</Version>
    <Authors>minicon eG</Authors>
    <Company>minicon eG</Company>
    <Description>Leichtgewichtige, MediatR-API-kompatible Mediator-Implementierung für .NET (CQRS, Request/Response, Notifications, Pipeline-Behaviors). Genau eine Laufzeit-Abhängigkeit.</Description>
    <PackageTags>mediator;cqrs;mediatr-alternative;pipeline;notifications;ddd</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/minicon-eg/Minicon.Mediator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML-Doc-Warnungen (fehlende Doku) nicht zum Fehler machen -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
